<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- MSBuild imports this file automatically for this project. Keep the
       engine's required references and packaging together when VS saves csproj. -->
  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Web.Extensions" />
    <None Include="Build\PackPdfWorker.ps1" />
    <None Include="Build\Get-LegacyPdfCacheCandidates.ps1" />
    <None Include="PdfWorker\pdf_worker.py" />
    <None Include="PdfWorker\build_runtime.py" />
    <None Include="PdfWorker\README.md" />
    <None Include="PdfWorker\ORDER_ITEM_PDF.md" />
    <None Include="README.md" />
    <None Include="Tests\PdfSettingsRegression.py" />
    <None Include="Tests\PdfWorkerRegression.py" />
    <None Include="Tests\PdfEngineDeploymentRegression.cs" />
    <None Include="Tests\Test-Deployment.ps1" />
  </ItemGroup>
  <Target Name="PackPdfWorker" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_PdfRuntimeArchive>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)PdfRuntime.zip'))</_PdfRuntimeArchive>
      <_PdfRuntimeManifest>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)PdfRuntime.manifest'))</_PdfRuntimeManifest>
    </PropertyGroup>
    <Error Condition="'$(_PdfRuntimeArchive)' == '' Or '$(_PdfRuntimeManifest)' == ''" Text="PDF runtime package paths could not be resolved." />
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Build\PackPdfWorker.ps1&quot; -Source &quot;$(MSBuildProjectDirectory)\PdfWorker&quot; -Archive &quot;$(_PdfRuntimeArchive)&quot; -Manifest &quot;$(_PdfRuntimeManifest)&quot;" />
    <ItemGroup>
      <EmbeddedResource Include="$(_PdfRuntimeArchive)">
        <LogicalName>PineTree.PdfEngine.PdfRuntime.zip</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="$(_PdfRuntimeManifest)">
        <LogicalName>PineTree.PdfEngine.PdfRuntime.manifest</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="PdfWorker\pdf_worker.py">
        <LogicalName>PineTree.PdfEngine.pdf_worker.py</LogicalName>
      </EmbeddedResource>
      <FileWrites Include="$(_PdfRuntimeArchive);$(_PdfRuntimeManifest)" />
    </ItemGroup>
  </Target>
</Project>
